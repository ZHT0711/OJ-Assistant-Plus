    "submit": "POST /api/在此填写提交接口",
    "submitBody": "{\"assignmentId\": \"{contestId}\", \"problemId\": \"{id}\", \"language\": \"{lang}\", \"code\": \"{code}\"}",
    "status": "POST /api/在此填写状态接口",
    "statusBody": "{\"id\": \"{submissionId}\"}"
  }
}
