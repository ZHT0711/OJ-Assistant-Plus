  "pathParseRule": {
    "contestProblem": "a[\\\\/](\\w+)[\\\\/](\\w+)[\\.\\w]*\\.(\\w+)$",
    "normalProblem": "problems?[\\\\/](\\w+)[\\.\\w]*\\.(\\w+)$"
  },
  "endpoints": {
    "problem": "POST /api/在此填写题目详情接口",
