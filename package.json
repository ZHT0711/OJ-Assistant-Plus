{
	"name": "oj-assistant-plus",
	"displayName": "OJ Assistant Plus",
	"description": "在 VS Code 里刷遍所有 OJ：洛谷 / 力扣 / NEU OJ / CSECG / HDOJ / Codeforces - 看题、测样例、一键交题",
	"publisher": "ZHT0711",
	"preview": false,
	"version": "0.6.7",
	"license": "SEE LICENSE IN LICENSE",
	"icon": "assets/icon/512x512.png",
	"engines": {
		"vscode": "^1.53.0"
	},
	"categories": [
		"Debuggers",
		"Other"
	],
	"activationEvents": [
		"workspaceContains:.ojassistconfig.json"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ZHT0711/OJ-Assistant-Plus"
	},
	"badges": [
		{
			"url": "https://isitmaintained.com/badge/resolution/lss233/OJ-Assistant.svg",
			"description": "Average time to resolve an issue",
			"href": "https://github.com/lss233/oj-assistant/issues"
		},
		{
			"url": "https://isitmaintained.com/badge/open/lss233/OJ-Assistant.svg",
			"description": "Percentage of issues still open",
			"href": "https://github.com/lss233/oj-assistant"
		},
		{
			"url": "https://img.shields.io/github/workflow/status/lss233/oj-assistant/Deploy%20Extension",
			"description": "Deploy Workflow",
			"href": "https://github.com/lss233/oj-assistant"
		}
	],
	"main": "./dist/extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"type": "webview",
					"id": "ojassistant.problemInfoView",
					"name": "Problem Info"
				}
			],
			"ojassistant": [
				{
					"id": "ojassistant.problems",
					"name": "题库"
				}
			]
		},
		"commands": [
			{
				"command": "ojassist.submit",
				"title": "OJ-Assist: Submit this code"
			},
			{
				"command": "ojassist.data",
				"title": "OJ-Assist: Open data file"
			},
			{
				"command": "ojassist.reload",
				"title": "OJ-Assist: Reload config"
			},
			{
				"command": "ojassist.webLogin",
				"title": "OJ-Assist: Login via browser (save cookies)"
			},
			{
				"command": "ojassist.initWorkspace",
				"title": "OJ-Assistant: 初始化刷题工作区 (GUI)"
			},
			{
				"command": "ojassist.searchProblems",
				"title": "搜索题目"
			},
			{
				"command": "ojassist.refreshProblems",
				"title": "刷新题库"
			},
			{
				"command": "ojassist.loadMoreProblems",
				"title": "OJ-Assistant: 题库加载更多"
			},
			{
				"command": "ojassist.openProblem",
				"title": "OJ-Assistant: 打开题目"
			},
			{
				"command": "ojassist.quickSubmit",
				"title": "OJ-Assist: ⬆️ Quick submit (current problem)"
			},
			{
				"command": "ojassist.openProblemInBrowser",
				"title": "OJ-Assist: 🌐 Open problem in browser"
			},
			{
				"command": "ojassist.pickLanguage",
				"title": "OJ-Assistant: 🌐 选择做题语言"
			},
			{
				"command": "ojassist.qqTranslateToken",
				"title": "OJ-Assistant: 获取腾讯翻译Token"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "ojassistant",
					"title": "OJ Assistant",
					"icon": "assets/icon/sidebar.svg"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "ojassist.searchProblems",
					"when": "view == ojassistant.problems",
					"group": "navigation@1"
				},
				{
					"command": "ojassist.refreshProblems",
					"when": "view == ojassistant.problems",
					"group": "navigation@3"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "node scripts/copy-katex.js && yarn run package",
		"compile": "node --openssl-legacy-provider ./node_modules/webpack/bin/webpack.js --config ./build/node-extension.webpack.config.js",
		"watch": "node --openssl-legacy-provider ./node_modules/webpack/bin/webpack.js --watch --config ./build/node-extension.webpack.config.js",
		"package": "node --openssl-legacy-provider ./node_modules/webpack/bin/webpack.js --mode production --devtool hidden-source-map --config ./build/node-extension.webpack.config.js",
		"test-compile": "tsc -p ./",
		"test-watch": "tsc -watch -p ./",
		"pretest": "yarn run test-compile && yarn run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^7.1.3",
		"@types/mocha": "^8.2.1",
		"@types/node": "^14.14.31",
		"@types/vscode": "^1.53.0",
		"@typescript-eslint/eslint-plugin": "^4.15.1",
		"@typescript-eslint/parser": "^4.15.1",
		"eslint": "^7.20.0",
		"glob": "^7.1.6",
		"mocha": "^8.3.0",
		"ts-loader": "^8.0.17",
		"typescript": "^4.1.5",
		"vscode-test": "^1.5.1",
		"webpack": "^5.99.0",
		"webpack-cli": "^4.10.0"
	},
	"dependencies": {
		"@3846masa/axios-cookiejar-support": "^1.0.1",
		"@types/cheerio": "^0.22.24",
		"@types/katex": "^0.11.0",
		"@types/qs": "^6.9.5",
		"@types/tough-cookie": "^4.0.0",
		"axios": "^0.21.1",
		"cheerio": "^1.0.0-rc.5",
		"katex": "^0.12.0",
		"puppeteer-core": "^25.13.0",
		"qs": "^6.9.6",
		"tough-cookie": "^4.0.0"
	}
}
